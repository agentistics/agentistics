{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "bun"
    ],
    "paths": {
      "@agentistics/core": [
        "./node_modules/@agentistics/core/src/index.ts"
      ],
      "@agentistics/core/*": [
        "./node_modules/@agentistics/core/src/*"
      ],
      "@agentistics/engine-api": [
        "./node_modules/@agentistics/engine-api/src/index.ts"
      ],
      "@agentistics/runtime": [
        "./runtime/src/index.ts"
      ]
    }
  },
  "include": [
    "index.ts",
    "engine/src",
    "engine/scripts",
    "runtime/src",
    "runtime/test",
    "runtime/*.ts",
    "scripts"
  ]
}
