# dependencies (bun install)
node_modules

# npm lock file (project uses bun)
package-lock.json

# output
out
dist
*.tgz

# binary release
release/

# native binary downloaded by @agentistics/agentop's postinstall
packages/agentop/bin/agentop-bin

# generated asset bundle (regenerated by build:binary)
src/embedded-dist.generated.ts
packages/server/server/embedded-dist.generated.ts
packages/server/server/engine-slot.generated.ts

# vite-plugin-pwa dev SW output
packages/web/dev-dist/

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# dev config backup (generated by the </> panel in the dashboard)
.env.config.bak

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Playwright / MCP artifacts
.playwright-mcp/

# npm lockfile (project uses bun)
package-lock.json

# large media files (served via GitHub Releases)
public/*.mp4
public/*.mov
public/*.webm
packages/web/public/*.mp4
packages/web/public/*.mov
packages/web/public/*.webm
.scion/agents/

# deploy env files (central.env etc.) — never commit secrets
*.env
*.env.bak
central.env.*

# git worktrees created by the harness
.claude/worktrees/
/report.md
/notes.md

# Agent scratch: SDD ledgers, briefs, reports and review packages.
# Neither committed nor shipped — and NOT in the Docker build context either
# (see .dockerignore): a review package landing here would otherwise invalidate
# `COPY . .` and re-run the whole Vite build.
.superpowers/

# Recording working directory (seed-demo + record-all/record-web output).
# Anchored to the root: the PUBLISHED casts live in docs/media/casts/ and are
# committed, and an unanchored `casts/` would silently swallow them too.
/casts/

# VS Code extension package
*.vsix

# The private engine, checked out by release.yml for the official build (engine.pin)
/.engine/
