#!/usr/bin/env bash
# fake-harness — ONE stand-in for every CLI harness, for the ENGINE.MAP bench only (never a real
# harness binary in the bench — owner rule 08/10). Install it as `claude`, `codex`, `gemini`,
# `copilot`, `kimi` and `agy`; the name it is called by picks the harness.
#
# Each personality writes that harness's REAL transcript shape at its REAL path (shapes taken from
# this machine's own files on 2026-10-08, keys only), draws just enough screen for agentop's send path,
# and answers every prompt with `ANSWER to [<prompt>] written_at=<epoch ms>` so the bench can time
# "harness wrote it → the web showed it".
#
#   claude  ~/.claude/projects/<cwd with / and . → ->/<id>.jsonl          (--session-id)
#   codex   ~/.codex/sessions/Y/M/D/rollout-<ts>-<uuid>.jsonl, written lazily on the first message
#   copilot ~/.copilot/session-state/<id>/events.jsonl                    (--session-id)
#   gemini  ~/.gemini/tmp/<cwd basename>/chats/session-<ts>-<8hex>.jsonl  (seed patch + one line per turn)
#   kimi    ~/.kimi-code/sessions/wd_<name>_<hash>/session_<uuid>/agents/main/wire.jsonl + session_index.jsonl
#   agy     ~/.gemini/antigravity-cli/brain/<uuid>/.system_generated/logs/transcript_full.jsonl, plus the
#           per-process log ~/.gemini/antigravity-cli/log/cli-<YYYYmmdd_HHMMSS>.log held OPEN. agy 1.3.2 no
#           longer writes `Created conversation <uuid>` there (measured: 0 of the 51 logs since 2026-10-05);
#           FAKE_AGY_CREATED_LINE=1 restores the pre-1.3 line.
# Env: FAKE_THINK_S (default 1).
set -u
H="$(basename "$0")"
SID=""; PROMPT=""; RESUME=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) SID="$2"; shift 2 ;;
    --resume|-S|--conversation) RESUME="$2"; shift 2 ;;
    resume) RESUME="${2:-}"; shift 2 ;;
    --model|--effort|--append-system-prompt|--permission-mode|-c|--agent-file|--prompt-interactive|-i|-m)
      [ "$1" = --prompt-interactive ] || [ "$1" = -i ] && PROMPT="$2"; shift 2 ;;
    --*) shift ;;
    *) PROMPT="$1"; shift ;;
  esac
done
[ -n "$RESUME" ] && SID="$RESUME"
uuid() { cat /proc/sys/kernel/random/uuid; }
[ -z "$SID" ] && SID="$(uuid)"
THINK="${FAKE_THINK_S:-1}"
STATE="$(mktemp -d)"; trap 'rm -rf "$STATE"' EXIT

write() { # role text
  python3 - "$H" "$SID" "$PWD" "$HOME" "$STATE" "$1" "$2" <<'PY'
import json, sys, os, uuid, datetime, hashlib, time
h, sid, cwd, home, state, role, text = sys.argv[1:8]
now = datetime.datetime.now(datetime.timezone.utc)
iso = now.isoformat(timespec='milliseconds').replace('+00:00', 'Z')
ms = int(time.time() * 1000)
st_file = os.path.join(state, 'st.json')
st = json.load(open(st_file)) if os.path.exists(st_file) else {}
def put(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'a') as f: f.write(json.dumps(obj) + '\n')
if h == 'claude':
    p = f"{home}/.claude/projects/{cwd.replace('/', '-').replace('.', '-')}/{sid}.jsonl"
    u = str(uuid.uuid4())
    e = ({"type": "user", "message": {"role": "user", "content": text}} if role == 'user' else
         {"type": "assistant", "message": {"id": "msg_" + u[:8], "role": "assistant", "model": "claude-fake-1",
          "content": [{"type": "text", "text": text}], "usage": {"input_tokens": 10, "output_tokens": 20,
          "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}}})
    e.update({"uuid": u, "parentUuid": st.get('parent'), "timestamp": iso, "sessionId": sid, "cwd": cwd, "version": "fake"})
    st['parent'] = u; put(p, e)
elif h == 'codex':
    p = st.get('path')
    if not p:
        p = f"{home}/.codex/sessions/{now:%Y/%m/%d}/rollout-{now:%Y-%m-%dT%H-%M-%S}-{sid}.jsonl"
        st['path'] = p
        put(p, {"timestamp": iso, "type": "session_meta", "payload": {"id": sid, "session_id": sid, "timestamp": iso, "cwd": cwd,
            "originator": "codex_cli_rs", "cli_version": "0.161.0", "source": "cli", "model_provider": "openai"}})
    kind = 'input_text' if role == 'user' else 'output_text'
    put(p, {"timestamp": iso, "type": "response_item", "payload": {"type": "message", "id": "msg_" + uuid.uuid4().hex[:12],
        "role": role, "content": [{"type": kind, "text": text}]}})
    if role != 'user':
        put(p, {"timestamp": iso, "type": "event_msg", "payload": {"type": "token_count", "info": {"total_token_usage":
            {"input_tokens": 10, "cached_input_tokens": 0, "output_tokens": 20, "reasoning_output_tokens": 0, "total_tokens": 30},
            "last_token_usage": {"input_tokens": 10, "cached_input_tokens": 0, "output_tokens": 20, "reasoning_output_tokens": 0, "total_tokens": 30},
            "model_context_window": 200000}}})
elif h == 'copilot':
    p = f"{home}/.copilot/session-state/{sid}/events.jsonl"
    if role == 'start':
        put(p, {"type": "session.start", "data": {"sessionId": sid, "version": 1, "producer": "copilot-agent", "copilotVersion": "1.0.93",
            "startTime": iso, "context": {"cwd": cwd}}, "timestamp": iso})
    elif role == 'user':
        put(p, {"type": "user.message", "data": {"content": text}, "timestamp": iso})
        put(p, {"type": "assistant.turn_start", "data": {"turnId": f"turn-{ms}"}, "timestamp": iso})
    else:
        put(p, {"type": "assistant.message", "data": {"model": "fake-model", "content": text}, "timestamp": iso})
        put(p, {"type": "assistant.turn_end", "data": {"turnId": f"turn-{ms}"}, "timestamp": iso})
elif h == 'gemini':
    p = st.get('path')
    if not p:
        p = f"{home}/.gemini/tmp/{os.path.basename(cwd)}/chats/session-{now:%Y-%m-%dT%H-%M}-{sid[:8]}.jsonl"
        st['path'] = p
        put(p, {"sessionId": sid, "projectHash": hashlib.sha256(cwd.encode()).hexdigest(), "startTime": iso, "lastUpdated": iso, "kind": "main"})
        put(p, {"$set": {"messages": [], "lastUpdated": iso}})
        root = f"{home}/.gemini/tmp/{os.path.basename(cwd)}/.project_root"
        if not os.path.exists(root): open(root, 'w').write(cwd)
    m = ({"id": str(uuid.uuid4()), "timestamp": iso, "type": "user", "content": [{"text": text}]} if role == 'user' else
         {"id": str(uuid.uuid4()), "timestamp": iso, "type": "gemini", "content": text, "model": "gemini-fake",
          "tokens": {"input": 10, "output": 20, "cached": 0, "thoughts": 0, "tool": 0, "total": 30}})
    put(p, m)
elif h == 'kimi':
    ws = f"wd_{os.path.basename(cwd)}_{hashlib.md5(cwd.encode()).hexdigest()[:12]}"
    d = f"{home}/.kimi-code/sessions/{ws}/session_{sid}"
    p = f"{d}/agents/main/wire.jsonl"
    if not os.path.exists(p):
        put(p, {"type": "metadata", "protocol_version": "1", "created_at": ms})
        put(f"{home}/.kimi-code/session_index.jsonl", {"sessionId": f"session_{sid}", "sessionDir": d, "workDir": cwd})
    # state.json — the legacy kimi adapter builds a session only from it (adapters/kimi.ts:64)
    sp = f"{d}/state.json"
    old_st = json.load(open(sp)) if os.path.exists(sp) else {"id": f"session_{sid}", "version": 1, "cwd": cwd, "createdAt": ms,
              "archived": False, "agents": {"main": {"homedir": d + "/agents/main", "type": "main"}}, "custom": {},
              "title": "bench", "titleKind": "auto", "isCustomTitle": False}
    old_st.update({"updatedAt": ms, "lastPrompt": text if role == 'user' else old_st.get('lastPrompt', ''), "lastTurnReason": "end_turn"})
    json.dump(old_st, open(sp, 'w'))
    if role == 'user':
        put(p, {"type": "turn.prompt", "agentId": "main", "input": [{"type": "text", "text": text}], "origin": {"kind": "user"}, "time": ms})
        put(p, {"type": "context.append_message", "agentId": "main", "message": {"role": "user", "content": [{"type": "text", "text": text}],
            "toolCalls": [], "origin": {"kind": "user"}, "id": str(uuid.uuid4())}, "time": ms})
    else:
        put(p, {"type": "context.append_message", "agentId": "main", "message": {"role": "assistant", "content": [{"type": "text", "text": text}],
            "toolCalls": [], "id": str(uuid.uuid4())}, "time": ms})
        put(p, {"type": "turn.ended", "agentId": "main", "time": ms})
elif h == 'agy':
    p = f"{home}/.gemini/antigravity-cli/brain/{sid}/.system_generated/logs/transcript_full.jsonl"
    n = st.get('step', 0)
    put(p, {"step_index": n, "source": "USER_EXPLICIT" if role == 'user' else "MODEL",
            "type": "USER_INPUT" if role == 'user' else "PLANNER_RESPONSE", "status": "DONE", "created_at": iso, "content": text})
    st['step'] = n + 1
json.dump(st, open(st_file, 'w'))
PY
}

# agy: the per-process log, held open for the life of the process (how agentop links agy today).
if [ "$H" = agy ]; then
  mkdir -p "$HOME/.gemini/antigravity-cli/log"
  exec 7>>"$HOME/.gemini/antigravity-cli/log/cli-$(date +%Y%m%d_%H%M%S).log"
  echo "version: 1.3.2" >&7
fi
[ "$H" = copilot ] && write start ""

turn() {
  local text="$1"
  # strip bracketed-paste markers (codex is sent with tmux paste-buffer -p)
  text="${text//$'\e[200~'/}"; text="${text//$'\e[201~'/}"
  [ "$H" = agy ] && [ "${FAKE_AGY_CREATED_LINE:-0}" = 1 ] && [ ! -e "$STATE/created" ] && { echo "Created conversation $SID" >&7; touch "$STATE/created"; }
  write user "$text"
  [ "$H" = codex ] && clear
  echo "✻ Working… (esc to interrupt)"
  sleep "$THINK"
  write assistant "ANSWER to [$text] written_at=$(date +%s%3N)"
  echo "● answered"
}

draw() {
  echo "────────────────────────────────────────────────────────────"
  if [ "$H" = codex ]; then printf '\n  100%% left · fake codex\033[1A\r› '; else printf '> '; fi
}

clear
echo "✻ fake $H (bench)  session $SID"
[ -n "$PROMPT" ] && turn "$PROMPT"
while true; do
  draw
  IFS= read -r line || exit 0
  [ "$H" = codex ] || { echo "────────────────────────────────────────────────────────────"; echo "  ? for shortcuts"; }
  [ -z "${line// /}" ] && continue
  turn "$line"
done
