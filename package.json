{
  "name": "agentistics",
  "version": "2.88.0",
  "description": "Local analytics dashboard for AI coding assistants — tracks tokens, cost, sessions, and activity from ~/.claude/",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "analytics",
    "dashboard",
    "developer-tools",
    "opentelemetry"
  ],
  "homepage": "https://github.com/agentistics/agentistics",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentistics/agentistics.git"
  },
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun packages/server/scripts/engine-slot.ts --if-missing && bun run --cwd packages/server server/index.ts",
    "cli": "bun packages/server/scripts/engine-slot.ts --if-missing && bun packages/server/bin/cli.ts",
    "dev:ui": "bun run --cwd packages/web dev",
    "dev": "bun run concurrently \"bun run dev:api\" \"bun run dev:ui\"",
    "dev:central": "AGENTISTICS_TEAM_CENTRAL=1 bun --watch --env-file=central.env packages/server/server/index.ts",
    "dev:ui:central": "WEB_PORT=48080 bun run --cwd packages/web dev",
    "dev:central:all": "bun run concurrently \"bun run dev:central\" \"bun run dev:ui:central\"",
    "build": "bun run --cwd packages/web build",
    "bin": "bun build:binary && mkdir -p ~/.local/bin && cp -f ./release/agentop ~/.local/bin/.agentop.new && mv -f ~/.local/bin/.agentop.new ~/.local/bin/agentop",
    "restart:all": "bun run bin && agentop restart all --rebuild",
    "build:assets": "bun run packages/server/scripts/embed-dist.ts && bun run engine:slot",
    "engine:slot": "bun run packages/server/scripts/engine-slot.ts",
    "engine:slot:null": "bun run packages/server/scripts/engine-slot.ts --null",
    "build:vscode": "bun run --cwd packages/vscode build",
    "package:vscode": "bun run --cwd packages/vscode package",
    "build:binary": "bun run build && bun run build:assets && bun build --compile packages/server/bin/cli.ts --outfile ./release/agentop",
    "build:binary:windows": "bun run build && bun run build:assets && bun build --compile --target=bun-windows-x64 packages/server/bin/cli.ts --outfile ./release/agentop.exe",
    "build:desktop": "bun run build:binary:windows && cd packages/desktop && cargo tauri build",
    "preview": "bun run --cwd packages/web preview",
    "watch": "bun run --cwd packages/server server/otel-watcher.ts",
    "up:central": "bash central.sh up",
    "init:central": "bash central.sh init",
    "central": "bun packages/server/bin/cli.ts server --central",
    "central:bg": "bun packages/server/bin/cli.ts server --central --bg",
    "stub": "bun run packages/server/scripts/ensure-type-stub.ts",
    "test": "bun test",
    "prepare": "husky",
    "mcp": "bun run packages/mcp/agentistics-mcp.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "latest",
    "@types/html2canvas": "^1.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "playwright": "^1.62.1",
    "vite": "^8.0.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  }
}
