# `node_modules` alone matches the ROOT entry only — Docker patterns are not recursive — so
# every workspace's node_modules was still being sent (packages/web's is 20MB).
node_modules
**/node_modules
.git
.claude
dist
**/dist
**/embedded-dist.generated.ts
docs/superpowers
*.log
.env
release/
packages/web/dev-dist/
.scion/
grafana/
.github/
.husky/
coverage/
*.lcov
*.tsbuildinfo

# Agent scratch — see the note in .gitignore. Excluded here so writing a review
# package never busts the build cache.
.superpowers

# The private engine checkout (release.yml / engine.pin). It reaches the official build ONLY as a
# bind-mounted named context (`--build-context engine=.engine`), never through `COPY . .`.
.engine
