{
  "name": "@agentistics/server",
  "version": "2.90.4",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run server/index.ts",
    "watch": "bun run server/otel-watcher.ts",
    "build:binary": "bun build --compile --minify bin/cli.ts --outfile ../../release/agentop",
