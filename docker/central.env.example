# agentistics — central.env example
#
# Copy it next to the compose you are using and fill it in:
#   cp docker/central.env.example central.env && chmod 600 central.env
#
# Or let a wizard write it for you (it generates the secrets and chmods the file):
#   ./central.sh init          # repo checkout
#   agentop central init       # installed binary, no checkout
#
# Name it central.env, NOT .env: `bun run dev` auto-loads a plain `.env`, so a developer's
# local instance would wrongly inherit AGENTISTICS_TEAM_CENTRAL=1 from it.
# NEVER commit this file — it holds the session secret and any ingest token.
#
# Full reference: docs/central-deploy.md § Configuration · publishing: docs/exposure.md

# ---------------------------------------------------------------------------
# Where it listens
# ---------------------------------------------------------------------------

# Host port the central is served on. 48080 by default; a member/solo machine uses 47291/47292,
# so a central on the same host does not collide.
APP_PORT=48080

# Interface the container publishes on. LOOPBACK BY DEFAULT — reachable from this host only,
# which is all a tunnel or a local reverse proxy needs.
#   127.0.0.1   this host only (default, and the right answer behind cloudflared/nginx/Caddy)
#   100.x.y.z   your Tailscale address — tailnet peers only
#   0.0.0.0     every interface the host can route, LAN included
# Widen it deliberately. Do NOT widen it to publish on the internet — keep loopback and put a
# tunnel or a TLS proxy in front (docs/exposure.md).
BIND_IP=127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The bundled Mongo (started by docker/central.localdb.yml). Point it at an external cluster
# instead — mongodb+srv://…@atlas/ or mongodb://host:27017/db — and the bundled container is
# not started at all; `agentop central up` then runs the central NATIVELY, without Docker.
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=agentistics

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

AGENTISTICS_TEAM_CENTRAL=1

# Organisation namespace for team sessions. Naming it (rather than leaving `default`) is also
# what makes the first boot create a team named after it.
AGENTISTICS_TEAM_ORG=your-org-name

# HMAC key for session cookies — generate with: openssl rand -hex 32
# Leave it EMPTY and the central generates one and persists it in Mongo. It is never derived
# from any password: a value equal to AGENTISTICS_TEAM_PASSWORD refuses to boot.
AGENTISTICS_TEAM_SESSION_SECRET=

# There is no dashboard password. A central authenticates ACCOUNTS: on first boot it has none,
# prints a one-time OWNER setup token to its log, and the browser asks you to create the owner
# with it. AGENTISTICS_TEAM_PASSWORD is the legacy pre-accounts gate — leave it unset.

# ---------------------------------------------------------------------------
# Exposure — what this instance is ALLOWED to do
#
# One setting decides it. Unset means `lan` on a central; an unrecognised value fails closed to
# `public`. See docs/exposure.md for the full table and the go-live checklist.
#
#   local    solo machine on 127.0.0.1 — full host power
#   lan      trusted network — host power off unless AGENTISTICS_ALLOW_LOCAL_SHELL=1
#   public   published on the internet — host power permanently off, no opt-in
# ---------------------------------------------------------------------------

AGENTISTICS_EXPOSURE=lan

# Re-enable the host-power routes (/api/exec, /api/chat-tty, the host transcript readers,
# /api/mcp-action) on a `lan` central. IGNORED on `public`. Leave it unset unless you mean it.
# AGENTISTICS_ALLOW_LOCAL_SHELL=1

# TLS is terminated in front of this container (tunnel, reverse proxy, tailscale serve):
# adds Secure + the __Host- cookie prefix and emits HSTS. Required on `public`.
# AGENTISTICS_TEAM_TLS=1

# Believe CF-Connecting-IP / X-Forwarded-For for rate limiting and audit logging. Set it ONLY
# when that proxy is the sole way in — otherwise a client picks its own rate-limit bucket by
# sending the header.
# AGENTISTICS_TRUST_PROXY=1

# Comma-separated browser origins allowed cross-origin. Normally EMPTY: the dashboard is served
# by this same process, so it is same-origin. Only for a split deployment (SPA hosted elsewhere).
# AGENTISTICS_ALLOWED_ORIGINS=https://metrics.example.com

# ---------------------------------------------------------------------------
# CI ingest (optional) — see docs/github-actions.md
# ---------------------------------------------------------------------------

# Static bearer token for POST /api/team/ingest. Generate with: openssl rand -hex 24
# Leave empty to allow unauthenticated ingestion (only sane on a `local`/`lan` instance).
AGENTISTICS_TEAM_INGEST_TOKEN=

# Keyless GitHub Actions OIDC — preferred over a static token, because nothing is stored.
# Set it to the audience your workflow requests; the issuer defaults to GitHub.
# AGENTISTICS_OIDC_AUDIENCE=agentistics
# AGENTISTICS_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Serve ONLY POST /api/team/ingest and 404 everything else. For the public half of a split
# deployment — see docker/central.ingest-only.yml.
# AGENTISTICS_INGEST_ONLY=1

# ---------------------------------------------------------------------------
# Self-contribution (optional)
# ---------------------------------------------------------------------------

# Set this to the central machine's own identity (e.g. your e-mail) to ALSO show this machine's
# local assistant usage in the dashboard — one instance acting as central AND member.
#
# It makes compose mount the host's ~/.claude, ~/.codex, ~/.gemini and ~/.copilot read-only into
# the container (docker/central.selfcontrib.yml). Do NOT set it on an exposed central: that
# instance would be holding every raw transcript on the machine. Empty = a dedicated central
# with no host filesystem access at all.
AGENTISTICS_CENTRAL_USER=

# ---------------------------------------------------------------------------
# Image (optional)
# ---------------------------------------------------------------------------

# Only read by the published-image path (docker/central.image.yml). `agentop central up` sets it
# to its own version so the central matches the CLI that deployed it; pin your own here.
# AGENTISTICS_IMAGE=ghcr.io/agentistics/agentistics:latest
